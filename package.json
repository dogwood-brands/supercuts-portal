{
  "name": "sc-portal",
  "version": "1.0.0",
  "private": true,
  "description": "SC Portal: employee and leadership portal for the SC Entities Supercuts salons",
  "main": "server/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server/index.js",
    "migrate": "node server/migrate.js",
