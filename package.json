    "seed:reset": "node server/seed/run.js --reset",
    "test": "node --test test/*.test.js",
    "backup": "sh scripts/backup.sh"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "compression": "^1.8.1",
    "express": "^4.22.3",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.3.0"
  }
}
